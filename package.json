{
  "name": "jshooks-template",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "js2wasm-cli contracts/index.ts build",
    "test": "LOG_LEVEL=error VITE_CJS_TRACE=true vitest integration",
    "test:unit": "pnpm test -- ./test/unit/**/*.test.ts",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "xrpld:start": "xrpld-netgen up:standalone --protocol xahau --version 2025.3.12-jshooks+1500",
    "xrpld:stop": "xrpld-netgen down:standalone --protocol xahau --version 2025.3.12-jshooks+1500",
    "trace": "docker logs --tail 100 -f xahau 2>&1 | cut -d ' ' -f 5- | grep -E 'Publishing ledger|HookInfo|HookTrace|HookError|preclaim result'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@transia/xahau-models": "2.7.3-alpha.29",
    "dotenv": "^16.4.7",
    "jshooks-api": "^1.0.5",
    "xahau": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@transia/hooks-toolkit": "2.0.0",
    "@transia/ripple-binary-codec": "1.4.6-alpha.10",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^22.13.10",
    "@xahau/hooks-cli": "^2.0.5",
    "lefthook": "^1.11.3",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  }
}
